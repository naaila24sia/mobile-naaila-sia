<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_header_setengah_lingkaran"
        android:backgroundTint="#6200EE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Selamat Datang!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/menuGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:columnCount="1"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/background_header"
        app:layout_constraintVertical_bias="0.3">

        <Button
            android:id="@+id/btnToSecond"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 2"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToThird"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 3"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToFourth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 4"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToFifth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 5"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToSeven"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 7"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToNinth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 9"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnToTenth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#6200EE"
            android:text="Pertemuan 10"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

    </androidx.gridlayout.widget.GridLayout>

    <Button
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="Logout"
        android:textColor="#D32F2F"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#D32F2F" />

</androidx.constraintlayout.widget.ConstraintLayout>